DATABASE_URL=
ENCRYPTION_KEY=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
PUBLIC_BASE_URL=
PORT=
SESSION_SECRET=
# Access control (both optional). Set RESTRICT_ACCESS=true to enforce the allowlist;
# otherwise the server is open to anyone. ALLOWED_WHOOP_EMAILS is the comma-separated
# list of WHOOP account emails allowed when restriction is on.
RESTRICT_ACCESS=false
ALLOWED_WHOOP_EMAILS=

# Personal integrations (optional, owner-only). Owners are the WHOOP emails in OWNER_EMAILS
# (defaults to ALLOWED_WHOOP_EMAILS). Hevy needs a Hevy Pro API key; Strava needs an API
# application from https://www.strava.com/settings/api with the callback domain set to your host.
OWNER_EMAILS=
HEVY_API_KEY=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Sleep coach (optional): Alexa tells you when to wind down, go to bed and wake up, timed from
# your WHOOP sleep need, and fires your Alexa routines (AC, music...) via the Voice Monkey skill.
# Leave VOICE_MONKEY_TOKEN empty to disable. See README "Sleep coach".
VOICE_MONKEY_TOKEN=
VOICE_MONKEY_SPEAKER=
VOICE_MONKEY_WIND_DOWN_TRIGGER=
VOICE_MONKEY_BEDTIME_TRIGGER=
VOICE_MONKEY_MORNING_TRIGGER=
SLEEP_COACH_SECRET=
SLEEP_COACH_OWNER_EMAIL=
SLEEP_COACH_NAME=
SLEEP_COACH_TIMEZONE=Asia/Kolkata
SLEEP_COACH_WAKE_TIME=06:30
SLEEP_COACH_WEEKEND_WAKE_TIME=
SLEEP_COACH_WIND_DOWN_MINUTES=30
# "whoop" = good-morning fires when WHOOP reports you awake (needs the webhook URL set in the
# WHOOP developer dashboard); the scheduled one becomes a fallback this many minutes later.
SLEEP_COACH_WAKE_SOURCE=time
SLEEP_COACH_WAKE_FALLBACK_MINUTES=30
