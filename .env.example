DATABASE_URL=
ENCRYPTION_KEY=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
PUBLIC_BASE_URL=
PORT=
SESSION_SECRET=
# Access control (both optional). Set RESTRICT_ACCESS=true to enforce the allowlist;
# otherwise the server is open to anyone. ALLOWED_WHOOP_EMAILS is the comma-separated
# list of WHOOP account emails allowed when restriction is on.
RESTRICT_ACCESS=false
ALLOWED_WHOOP_EMAILS=

# Personal integrations (optional, owner-only). Owners are the WHOOP emails in OWNER_EMAILS
# (defaults to ALLOWED_WHOOP_EMAILS). Hevy needs a Hevy Pro API key; Strava needs an API
# application from https://www.strava.com/settings/api with the callback domain set to your host.
OWNER_EMAILS=
HEVY_API_KEY=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
